# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/finmanai?schema=public"

# Field encryption. 32 raw bytes, base64. NEVER commit real values.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_KEY_ACTIVE="v1"
FIELD_KEY_V1=""
# Add FIELD_KEY_V2 and move FIELD_KEY_ACTIVE to v2 to rotate. Keep V1 until every
# row has been re-encrypted — retired keys are needed to read old ciphertext.

# Peppers hashed IP addresses so a stolen DB can't be brute-forced against IPv4.
IP_PEPPER=""

# advisory | diagnostic_only
# Keep this diagnostic_only until RIA registration lands.
ADVISORY_MODE="diagnostic_only"

# Optional. Absent = deterministic fallback narrative, which always works.
ANTHROPIC_API_KEY=""

# Used in reminder emails to build links back into the app. No trailing slash.
APP_URL="http://localhost:3000"

# console | <your adapter>
# Queued mail is printed rather than sent. Pointing this at an unimplemented
# transport throws at startup — deliberately, so mail is never silently dropped.
MAIL_TRANSPORT="console"

# SMTP, used when MAIL_TRANSPORT="smtp".
#
# Local catcher (Mailpit — brew install mailpit, then `mailpit`):
#   SMTP_HOST="localhost"   SMTP_PORT="1025"   (no user/password)
#   Inbox at http://localhost:8025
#
# A real provider — Gmail needs an App Password, not your account password:
#   SMTP_HOST="smtp.gmail.com"  SMTP_PORT="587"
#   SMTP_USER="you@gmail.com"   SMTP_PASSWORD="<16-char app password>"
#
# 587 starts plaintext and upgrades via STARTTLS; 465 is implicit TLS. SMTP_SECURE
# follows the port unless you set it. Getting it backwards makes SMTP appear to hang.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="FinManAI <no-reply@finmanai.local>"

# Scratch database Prisma resets when authoring a migration. Needed only because
# the app role is NOCREATEDB and so cannot create one itself. Never holds real data.
SHADOW_DATABASE_URL="postgresql://user:pass@localhost:5432/finmanai_shadow?schema=public"

# Google Sign-In. Leave blank to hide the button and use email + password only.
#   1. https://console.cloud.google.com → create or pick a project
#   2. APIs & Services → OAuth consent screen → External → add yourself as a Test user
#   3. APIs & Services → Credentials → Create credentials → OAuth client ID → Web application
#   4. Authorised redirect URI:  http://localhost:3000/api/auth/google/callback
#      (it must match APP_URL exactly, including the port)
# The secret is a bearer credential for the sign-in flow: it belongs in .env,
# never here. This file is the one env file git tracks.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
